{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Local development uses the top-level settings. CI deploys with
  // --env staging (on every merge to main) or --env production (on a release).
  // Durable Object bindings and rate limiters are not inherited by
  // environments, so each environment repeats them.
  "name": "lunchrad-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Preview URLs would expose every uploaded version on a public URL. Off.
  "preview_urls": false,
  "assets": {
    "directory": "../app/dist/app/browser",
    "binding": "ASSETS",
    // Unknown paths fall through to the Worker, which serves the app shell
    // with a fresh CSP nonce. The shell itself must also go through the
    // Worker, hence "/" and "/index.html". Hashed JS/CSS files are served
    // straight from the asset layer (headers from public/_headers).
    "not_found_handling": "none",
    "run_worker_first": ["/", "/index.html", "/sw.js", "/api/*", "/admin/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // One Durable Object per room, SQLite-backed (the only kind on the free plan).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Presets, the admin audit log, open rooms, the admin-set team key.
  // Schema in migrations/, applied by the deploy workflows before each deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunchrad-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  // Approximate, per-location limits, per client IP. A whole office shares one
  // IP, so they are sized for ~20 colleagues at once (M8): entering the team key
  // 20/min, creating rooms 5/min, joining 60/min, WebSocket connects 300/min
  // (phones reconnect after sleep or a Wi-Fi switch). Hits are logged as
  // "Rate limited" with the route, never the IP. SESSION_GLOBAL_LIMITER caps
  // team-key attempts from all IPs together (30/min per location), so a
  // botnet cannot guess in parallel. Counters are shared by
  // namespace_id, so every environment gets its own ids.
  "ratelimits": [
    { "name": "SESSION_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "CREATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "WS_LIMITER", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
    {
      "name": "SESSION_GLOBAL_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
  },
  "env": {
    "staging": {
      "name": "lunchrad-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lunchrad-staging",
          "database_id": "ac3884dd-baf0-439a-a575-fcea68cf8fab",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
      },
      "ratelimits": [
        {
          "name": "SESSION_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "CREATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "JOIN_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "WS_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "SESSION_GLOBAL_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "lunchrad",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lunchrad",
          "database_id": "ff09daf3-01ab-4fe7-b79d-fbde2e9457a7",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
      },
      "ratelimits": [
        {
          "name": "SESSION_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "CREATE_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "JOIN_LIMITER",
          "namespace_id": "3003",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "WS_LIMITER",
          "namespace_id": "3004",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "SESSION_GLOBAL_LIMITER",
          "namespace_id": "3005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
  },
}
